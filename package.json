{
  "name": "Finance-Pro-Desktop",
  "version": "0.1.0",
  "description": "Finance Pro Desktop est une application multiplateforme Windows/Linux basée sur Electron, intégrant l’interface web Finance Pro et un moteur de stockage local SQLite pour assurer la continuité des opérations hors connexion, avec synchronisation des données lorsque la connexion est disponible.",
  "main": "main.js",
  "author": "ONG Finance Pro",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "build": {
    "appId": "com.ongfinancepro.desktop",
    "productName": "Finance Pro",
    "copyright": "Copyright 2026 Finance Pro",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "publish":{
      "provider": "s3",
      "endpoint": "https://6a3dfa1e4c9e48b780d4ae56e8c0c780.r2.cloudflarestorage.com",
      "bucket": "financepro-updates",
      "region": "auto",
      "path": "/v1",
      "acl": "public-read",
      "channel": "latest"
    },
    "extraResources": [
      {
        "from": "../frontend-web/dist",
        "to": "frontend-web/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
